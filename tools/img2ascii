#!/usr/bin/env python3
"""img2ascii — convert an image into shaded ASCII art for the sopranos CLI.

Feed it any image you have (e.g. your own screenshots) and drop the output
into art/<speaker-slug>.txt so the CLI picks it up:

    tools/img2ascii tony.png -w 60 -o art/tony-soprano.txt

The default ramp assumes a dark terminal (bright pixels -> dense glyphs).
Use --invert if your terminal or viewer has a light background.
"""

import argparse
import sys

try:
    from PIL import Image, ImageOps
except ImportError:
    sys.exit("img2ascii: needs Pillow — run: pip install pillow")

# darkest -> brightest, tuned for dark-background terminals
RAMP = " .:-=+*#%@"


def convert(path, width, aspect, invert):
    img = Image.open(path).convert("L")
    img = ImageOps.autocontrast(img)
    w, h = img.size
    height = max(1, round(h * (width / w) * aspect))
    img = img.resize((width, height), Image.LANCZOS)

    ramp = RAMP[::-1] if invert else RAMP
    n = len(ramp)
    px = img.load()
    lines = []
    for y in range(height):
        lines.append("".join(ramp[px[x, y] * n // 256] for x in range(width)))
    return "\n".join(line.rstrip() for line in lines) + "\n"


def main():
    p = argparse.ArgumentParser(
        description="convert an image to shaded ASCII art",
        epilog="output is plain text; pipe to a file or use -o",
    )
    p.add_argument("image", help="source image (any format Pillow reads)")
    p.add_argument("-w", "--width", type=int, default=48,
                   help="output width in characters (default 48)")
    p.add_argument("-o", "--out", help="write to this file instead of stdout")
    p.add_argument("--aspect", type=float, default=0.5,
                   help="terminal cell height compensation (default 0.5)")
    p.add_argument("--invert", action="store_true",
                   help="flip the ramp for light backgrounds")
    a = p.parse_args()

    art = convert(a.image, a.width, a.aspect, a.invert)
    if a.out:
        with open(a.out, "w") as f:
            f.write(art)
        print(f"wrote {a.out}", file=sys.stderr)
    else:
        sys.stdout.write(art)


if __name__ == "__main__":
    main()
