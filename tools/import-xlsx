#!/usr/bin/env python3
"""import-xlsx — convert a quotes spreadsheet into quotes.tsv.

Expects columns named Quote, Speaker, Episode Title, Ep. Code (any order).
Usage: tools/import-xlsx FILE.xlsx > quotes.tsv
"""

import sys

try:
    import openpyxl
except ImportError:
    sys.exit("import-xlsx: needs openpyxl — run: pip install openpyxl")


def clean(s):
    # fields are tab-separated, so strip tabs/newlines from values
    return " ".join(str(s).split())


def pick(header, *names):
    for n in names:
        if n in header:
            return header.index(n)
    sys.exit(f"import-xlsx: no column named {' / '.join(names)}")


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    # use the first sheet that has Quote/Speaker columns
    for ws in openpyxl.load_workbook(sys.argv[1]).worksheets:
        rows = ws.iter_rows(values_only=True)
        header = [clean(c).lower() for c in next(rows)]
        if "quote" in header and "speaker" in header:
            break
    else:
        sys.exit("import-xlsx: no sheet with Quote and Speaker columns")
    q = header.index("quote")
    s = header.index("speaker")
    t = pick(header, "episode title", "episode")
    c = pick(header, "ep. code", "code", "ep code")
    seen = set()
    for row in rows:
        if not row[q] or not row[s]:
            continue
        line = f"{clean(row[q])}\t{clean(row[s])}\t{clean(row[t])} ({clean(row[c])})"
        if line not in seen:
            seen.add(line)
            print(line)


if __name__ == "__main__":
    main()
