#!/usr/bin/env python3
"""get-cast-photos — fetch one freely-licensed cast photo per character.

Searches Wikimedia Commons by actor name, saves the first good hit as
cast-photos/<speaker-slug>.jpg, and records license/author in
cast-photos/CREDITS.txt. Stdlib only. Then run:

    tools/img2ascii cast-photos/

Character names below match the Speaker column of quotes.tsv; add a pair
here to cover a new speaker.
"""

import json, os, re, ssl, time, urllib.parse, urllib.request

API = "https://commons.wikimedia.org/w/api.php"
UA = {"User-Agent": "SopranosPortraits/1.0 (github.com/noahfinkelstein/homebrew-tonysoprano)"}
OUT = "cast-photos"
MIN_WIDTH = 400

CAST = [
    ("Tony Soprano", "James Gandolfini"),
    ("Carmela Soprano", "Edie Falco"),
    ("Christopher Moltisanti", "Michael Imperioli"),
    ("Dr. Melfi", "Lorraine Bracco"),
    ("Paulie Gualtieri", "Tony Sirico"),
    ("Silvio Dante", "Steven Van Zandt"),
    ("Junior Soprano", "Dominic Chianese"),
    ("Livia Soprano", "Nancy Marchand"),
    ("Meadow Soprano", "Jamie-Lynn Sigler"),
    ("A.J. Soprano", "Robert Iler"),
    ("Janice Soprano", "Aida Turturro"),
    ("Adriana La Cerva", "Drea de Matteo"),
    ("Big Pussy Bonpensiero", "Vincent Pastore"),
    ("Bobby Baccalieri", "Steve Schirripa"),
    ("Johnny Sack", "Vincent Curatola"),
    ("Ralph Cifaretto", "Joe Pantoliano"),
    ("Phil Leotardo", "Frank Vincent"),
    ("Artie Bucco", "John Ventimiglia"),
    ("Furio Giunta", "Federico Castelluccio"),
    ("Richie Aprile", "David Proval"),
    ("Vito Spatafore", "Joseph R. Gannascoli"),
    ("Hesh Rabkin", "Jerry Adler"),
    ("Little Carmine", "Ray Abruzzo"),
    ("Carmine Lupertazzi", "Tony Lip"),
    ("Gloria Trillo", "Annabella Sciorra"),
    ("Tony Blundetto", "Steve Buscemi"),
    ("Agent Harris", "Matt Servitto"),
    ("Charmaine Bucco", "Kathrine Narducci"),
    ("Rosalie Aprile", "Sharon Angela"),
    ("Patsy Parisi", "Dan Grimaldi"),
    ("Benny Fazio", "Max Casella"),
    ("Svetlana Kirilenko", "Alla Kliouka"),
    ("Jackie Aprile Jr.", "Jason Cerbone"),
    ("Dr. Elliot Kupferberg", "Peter Bogdanovich"),
]

ctx = ssl.create_default_context()


def slug(name):
    # must match the awk slug in ./sopranos
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def api(params):
    # retry with backoff: Commons 429s bursts of requests
    url = API + "?" + urllib.parse.urlencode(dict(params, format="json"))
    req = urllib.request.Request(url, headers=UA)
    for wait in (0, 10, 30):
        time.sleep(wait)
        try:
            with urllib.request.urlopen(req, timeout=30, context=ctx) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code != 429:
                raise
    raise RuntimeError("rate-limited after retries")


def find_image(actor):
    """First decent freely-licensed photo of this actor, or None."""
    res = api({"action": "query", "list": "search", "srnamespace": 6,
               "srsearch": f'"{actor}"', "srlimit": 10})
    titles = [h["title"] for h in res.get("query", {}).get("search", [])
              if re.search(r"\.(jpe?g|png)$", h["title"], re.I)]
    if not titles:
        return None
    info = api({"action": "query", "titles": "|".join(titles),
                "prop": "imageinfo", "iiprop": "url|size|extmetadata",
                "iiurlwidth": 1000})
    for page in info.get("query", {}).get("pages", {}).values():
        ii = (page.get("imageinfo") or [{}])[0]
        if not ii or ii.get("width", 0) < MIN_WIDTH:
            continue
        md = ii.get("extmetadata", {})
        return {
            "url": ii.get("thumburl") or ii.get("url"),
            "license": md.get("LicenseShortName", {}).get("value", "see Commons"),
            "author": re.sub("<[^>]+>", "", md.get("Artist", {}).get("value", "unknown")),
            "page": ii.get("descriptionurl", ""),
        }
    return None


def main():
    os.makedirs(OUT, exist_ok=True)
    credits, got = [], 0
    for character, actor in CAST:
        dest = os.path.join(OUT, slug(character) + ".jpg")
        if os.path.exists(dest):
            continue  # already fetched; reruns only fill gaps
        try:
            img = find_image(actor)
        except Exception as e:
            print(f"{character}: search failed ({e})")
            continue
        if not img:
            print(f"{character}: no freely-licensed photo found")
            continue
        try:
            req = urllib.request.Request(img["url"], headers=UA)
            with urllib.request.urlopen(req, timeout=45, context=ctx) as r, open(dest, "wb") as f:
                f.write(r.read())
        except Exception as e:
            print(f"{character}: download failed ({e})")
            continue
        got += 1
        credits.append(f"{slug(character)}.jpg — {actor} as {character}\n"
                       f"    source : {img['page']}\n"
                       f"    license: {img['license']}\n"
                       f"    author : {img['author']}\n")
        print(f"{character}: saved [{img['license']}]")
        time.sleep(3)  # stay under Commons rate limits

    # append so reruns that fill gaps keep earlier credits
    path = os.path.join(OUT, "CREDITS.txt")
    header = not os.path.exists(path)
    with open(path, "a", encoding="utf-8") as f:
        if header:
            f.write("Cast photographs from Wikimedia Commons; ASCII portraits in art/\n"
                    "are derived from these. Respect each license when reusing.\n\n")
        f.write("\n".join(credits) + "\n")
    print(f"\n{got}/{len(CAST)} photos -> {OUT}/")


if __name__ == "__main__":
    main()
