#!/bin/sh
# make-portraits — batch-convert a directory of images into art/ portraits.
#
# Name each image after the speaker slug (see README), e.g.:
#   portraits/tony-soprano.jpg  portraits/paulie-gualtieri.png
# then run:
#   tools/make-portraits portraits/ [width]
#
# Every image becomes art/<slug>.txt and the CLI picks it up immediately.

set -e
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$dir")

src=${1:?usage: make-portraits IMAGE_DIR [width]}
width=${2:-60}

count=0
for img in "$src"/*; do
    [ -f "$img" ] || continue
    base=$(basename "$img")
    slug=${base%.*}
    case $base in
        *.png|*.jpg|*.jpeg|*.gif|*.bmp|*.webp|*.PNG|*.JPG|*.JPEG) ;;
        *) echo "skipping $base (not an image)" >&2; continue ;;
    esac
    "$dir/img2ascii" "$img" -w "$width" -o "$root/art/$slug.txt"
    count=$((count + 1))
done

echo "converted $count portrait(s) into $root/art/" >&2
