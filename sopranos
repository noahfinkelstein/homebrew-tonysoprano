#!/bin/sh
# sopranos — print a quote from The Sopranos, with the speaker's ASCII portrait.
# Data lives in quotes.tsv next to this script: quote<TAB>speaker<TAB>episode
# Portraits live in art/<speaker-slug>.txt; art/default.txt is the fallback.

set -e
VERSION=2.0.0

# resolve symlinks so an installed `sopranos` (e.g. Homebrew's bin symlink)
# still finds quotes.tsv and art/ next to the real script
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname -- "$self")/$link ;;
    esac
done
dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
data="$dir/quotes.tsv"

usage() {
    echo "usage: sopranos [-n count] [-s speaker] [-e episode] [-l] [-q] [-i] [-V]" >&2
    echo "  -n count    print N random quotes (default 1)" >&2
    echo "  -s speaker  only quotes from a matching speaker (substring, case-insensitive)" >&2
    echo "  -e episode  only quotes from a matching episode (substring, case-insensitive)" >&2
    echo "  -l          list every matching quote instead of picking at random" >&2
    echo "  -q          quote only, no ASCII portrait" >&2
    echo "  -i          invert portrait shading (for light terminals)" >&2
    echo "  -V          print version" >&2
}

n=1 speaker='' episode='' list='' noart='' invert=''
while getopts "n:s:e:lqiVh" opt; do
    case $opt in
        n) n=$OPTARG ;;
        s) speaker=$OPTARG ;;
        e) episode=$OPTARG ;;
        l) list=1 ;;
        q) noart=1 ;;
        i) invert=1 ;;
        V) echo "sopranos $VERSION"; exit 0 ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done

# awk's srand() only varies per second; mix in the PID so rapid runs differ
seed=$(( $(date +%s) + $$ ))

# terminal size, so portraits shrink to fit small windows
cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
lines=${LINES:-$(tput lines 2>/dev/null || echo 24)}

awk -F'\t' -v n="$n" -v who="$speaker" -v ep="$episode" -v list="$list" \
    -v seed="$seed" -v noart="$noart" -v invert="$invert" -v artdir="$dir/art" \
    -v maxw="$((cols - 2))" -v maxh="$((lines - 8))" '
    BEGIN {
        # pixel level -> block glyph pair (2 columns per pixel = square cells)
        split(invert ? "██ ▓▓ ▒▒ ░░ ,," : ",, ░░ ▒▒ ▓▓ ██", g, " ")
        for (i = 1; i <= 5; i++) { gsub(/,/, " ", g[i]); glyph[i - 1] = g[i] }
    }
    function slug(name,    s) {
        s = tolower(name)
        gsub(/[^a-z0-9]+/, "-", s)
        gsub(/^-/, "", s); gsub(/-$/, "", s)
        return s
    }
    # print an art file, sampled every f-th row/column to fit the terminal.
    # digit-grid files (0-4 per pixel) render as shaded blocks; anything
    # else prints as literal ASCII art.
    function art(name,    file, line, a, h, i, j, w, f, out) {
        if (noart) return
        file = artdir "/" slug(name) ".txt"
        h = 0
        while ((getline line < file) > 0) { a[++h] = line }
        close(file)
        if (h == 0) {
            file = artdir "/default.txt"
            while ((getline line < file) > 0) { a[++h] = line }
            close(file)
        }
        f = 1
        if (a[1] ~ /^[0-4]+$/) {
            w = length(a[1])
            if (maxw >= 10 && w * 2 > maxw) f = int((w * 2 + maxw - 1) / maxw)
            if (maxh >= 10 && int(h / f) > maxh) f = int((h + maxh - 1) / maxh)
            for (i = 1; i <= h; i += f) {
                out = ""
                for (j = 1; j <= w; j += f) out = out glyph[substr(a[i], j, 1)]
                sub(/ +$/, "", out)
                print out
            }
        } else {
            w = 0
            for (i = 1; i <= h; i++) if (length(a[i]) > w) w = length(a[i])
            if (maxw >= 10 && w > maxw) f = int((w + maxw - 1) / maxw)
            if (maxh >= 10 && int(h / f) > maxh) f = int((h + maxh - 1) / maxh)
            for (i = 1; i <= h; i += f) {
                if (f == 1) { print a[i]; continue }
                out = ""
                for (j = 1; j <= length(a[i]); j += f) out = out substr(a[i], j, 1)
                print out
            }
        }
        split("", a)
    }
    function show(row,    f) {
        split(row, f, "\t")
        art(f[2])
        printf "\"%s\"\n  \342\200\224 %s, %s\n", f[1], f[2], f[3]
    }
    NF == 3 && (who == "" || index(tolower($2), tolower(who))) \
             && (ep == "" || index(tolower($3), tolower(ep))) { rows[++c] = $0 }
    END {
        if (c == 0) { print "sopranos: no matching quotes" > "/dev/stderr"; exit 1 }
        if (list) {
            for (i = 1; i <= c; i++) { if (i > 1) print ""; show(rows[i]) }
            exit
        }
        srand(seed)
        for (i = c; i > 1; i--) {
            j = int(rand() * i) + 1
            t = rows[i]; rows[i] = rows[j]; rows[j] = t
        }
        if (n > c) n = c
        for (i = 1; i <= n; i++) { if (i > 1) print ""; show(rows[i]) }
    }
' "$data"
